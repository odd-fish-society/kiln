// Kiln builds itself (spec §7a): the tool's sources live inside this plugin
// (src/, so `#include "core/hash.h"`-style lines are unchanged). Modules mirror
// the source folders. Every module depends on core, so core's link flags (the
// sanitizers, the static runtime) reach every binary.

const flags = require "build/flags"

plugin "kiln" {
    public_deps = { "blake3", "sqlite", "luau", "cli11", "json", "cluau" },
}

module "core" {
    sources = glob("src/core/*.cpp"),
    public_includes = { "src" },
    deps = { public = { "blake3/blake3", "sqlite/sqlite", "luau/luau_vm", "json/json" } },
    cpp_std = "c++20",
    flags = flags.flags,
    public_link_flags = flags.link_flags,
}

module "luau" {
    sources = glob("src/luau/*.cpp"),
    public_includes = { "src" },
    deps = { public = {
        "kiln/core",
        "luau/luau_vm",
        "luau/luau_ast",
        "luau/luau_compiler",
        "luau/luau_analysis",
        "luau/luau_config",
        "luau/luau_eqsat",
        "cluau/cluau",
        "cluau/cluau_check",
    } },
    cpp_std = "c++20",
    flags = flags.flags,
}

module "rules" {
    sources = glob("src/rules/*.cpp"),
    public_includes = { "src" },
    deps = { public = { "kiln/core", "blake3/blake3", "sqlite/sqlite" } },
    cpp_std = "c++20",
    flags = flags.flags,
}

module "console" {
    sources = glob("src/console/*.cpp"),
    public_includes = { "src" },
    deps = { public = { "kiln/core" } },
    cpp_std = "c++20",
    flags = flags.flags,
}

module "workspace" {
    sources = glob("src/workspace/*.cpp"),
    public_includes = { "src" },
    deps = { public = {
        "kiln/core",
        "kiln/luau",
        "kiln/rules",
        "kiln/console",
        "blake3/blake3",
        "sqlite/sqlite",
        "luau/luau_vm",
        "json/json",
    } },
    cpp_std = "c++20",
    flags = flags.flags,
}

module "cli" {
    sources = glob("src/cli/*.cpp"),
    public_includes = { "src" },
    deps = { public = { "kiln/core", "kiln/luau", "kiln/rules", "kiln/console",
                        "kiln/workspace", "cli11/cli11", "blake3/blake3", "sqlite/sqlite",
                        "luau/luau_vm", "luau/luau_ast",
                        "luau/luau_compiler", "luau/luau_analysis",
                        "luau/luau_config", "luau/luau_eqsat",
                        "json/json" } },
    cpp_std = "c++20",
    flags = flags.flags,
}
