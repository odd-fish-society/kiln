// The suite: one file per area, run through hamr's test library.

const flags = require "build/flags"

plugin "kiln_tests" {
    public_deps = { "kiln", "hamr" },
}

module "kiln_tests" {
    sources = glob("*.cpp"),
    private_includes = { "." },
    deps = { private = { "kiln/workspace", "hamr/hamr_test" } },
    cpp_std = "c++20",
    flags = flags.flags,
}
