// cluau: C-syntax-flavoured Luau, its own repository (github.com/Aosiee/cluau)
// checked out at cluau/ as a git submodule. A consuming workspace that also
// vendors cluau pins the same commit (its own tooling checks that). Kiln
// translates .cluau manifests with `cluau` (the translator: no dependencies).

plugin "cluau" {}

c_library "cluau" {
    sources = glob("cluau/src/translate/*.cpp"),
    includes = { "cluau/include", "cluau/src/translate" },
    public_includes = { "cluau/include" },
    cpp_std = "c++17",
}

// cluau_check: the strict rules over Luau's analysis (`kiln check`), built
// against the luau plugin's headers.
const lu = "../luau/luau/"
c_library "cluau_check" {
    sources = glob("cluau/src/check/*.cpp"),
    includes = {
        "cluau/include",
        lu .. "Analysis/include", lu .. "Ast/include", lu .. "Common/include",
        lu .. "EqSat/include", lu .. "Config/include",
    },
    public_includes = { "cluau/include" },
    cpp_std = "c++17",
}
