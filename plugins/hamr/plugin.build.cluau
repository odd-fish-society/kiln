// hamr's C++ test library: the one header hamr/test.h, from the hamr
// repository (a git submodule at hamr/ in this plugin). The kiln_tests target
// uses it; the kiln binary doesn't.

plugin "hamr" {}

c_library "hamr_test" {
    sources = {},
    public_includes = { "hamr/include" },
    cpp_std = "c++17",
}
