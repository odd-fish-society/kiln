// hamr's C++ test library: the one header hamr/test.h, from the hamr
// repository (a git submodule at hamr/ in this plugin). Only the CMake build
// of kiln_tests includes it; nothing in Kiln's own build graph links it.

plugin "hamr" {}

c_library "hamr_test" {
    sources = {},
    public_includes = { "hamr/include" },
    cpp_std = "c++17",
}
