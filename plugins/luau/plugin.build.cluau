// Luau (vendored; upstream as a git checkout inside the plugin dir at luau/
// — the extraction story registers it as a submodule there). One plugin per
// vendored library (spec §7a.1): the six c_libraries below are Luau's
// internal build granularity (Ast/Compiler/Config/EqSat/Analysis/VM), all
// hosting Luau sources, not separate libraries.

plugin "luau" {}

c_library "luau_ast" {
    sources = {
        "luau/Ast/src/Allocator.cpp",
        "luau/Ast/src/Ast.cpp",
        "luau/Ast/src/Confusables.cpp",
        "luau/Ast/src/Cst.cpp",
        "luau/Ast/src/Lexer.cpp",
        "luau/Ast/src/Location.cpp",
        "luau/Ast/src/Parser.cpp",
        "luau/Ast/src/StringUtils.cpp",
        "luau/Ast/src/TimeTrace.cpp",
    },
    includes = {
        "luau/Ast/include",
        "luau/Common/include",
    },
    public_includes = {
        "luau/Ast/include",
        "luau/Common/include",
    },
    cpp_std = "c++17",
}
c_library "luau_compiler" {
    sources = {
        "luau/Compiler/src/BuiltinFolding.cpp",
        "luau/Compiler/src/Builtins.cpp",
        "luau/Compiler/src/BytecodeBuilder.cpp",
        "luau/Compiler/src/Compiler.cpp",
        "luau/Compiler/src/ConstantFolding.cpp",
        "luau/Compiler/src/CostModel.cpp",
        "luau/Compiler/src/TableShape.cpp",
        "luau/Compiler/src/Types.cpp",
        "luau/Compiler/src/ValueTracking.cpp",
        "luau/Compiler/src/lcode.cpp",
    },
    includes = {
        "luau/Ast/include",
        "luau/Common/include",
        "luau/Compiler/include",
        "luau/VM/include",
        "luau/Analysis/include",
        "luau/Config/include",
        "luau/EqSat/include",
    },
    public_includes = {
        "luau/Compiler/include",
        "luau/Ast/include",
        "luau/Common/include",
    },
    cpp_std = "c++17",
}
c_library "luau_config" {
    sources = {
        "luau/Config/src/Config.cpp",
        "luau/Config/src/LinterConfig.cpp",
    },
    includes = {
        "luau/Ast/include",
        "luau/Common/include",
        "luau/Compiler/include",
        "luau/VM/include",
        "luau/Analysis/include",
        "luau/Config/include",
        "luau/EqSat/include",
    },
    public_includes = {
        "luau/Config/include",
        "luau/Ast/include",
        "luau/Common/include",
    },
    cpp_std = "c++17",
}
c_library "luau_eqsat" {
    sources = {
        "luau/EqSat/src/Id.cpp",
        "luau/EqSat/src/UnionFind.cpp",
    },
    includes = {
        "luau/Ast/include",
        "luau/Common/include",
        "luau/Compiler/include",
        "luau/VM/include",
        "luau/Analysis/include",
        "luau/Config/include",
        "luau/EqSat/include",
    },
    public_includes = {
        "luau/EqSat/include",
        "luau/Common/include",
    },
    cpp_std = "c++17",
}
c_library "luau_analysis" {
    sources = {
        "luau/Analysis/src/Anyification.cpp",
        "luau/Analysis/src/ApplyTypeFunction.cpp",
        "luau/Analysis/src/AstJsonEncoder.cpp",
        "luau/Analysis/src/AstQuery.cpp",
        "luau/Analysis/src/Autocomplete.cpp",
        "luau/Analysis/src/AutocompleteCore.cpp",
        "luau/Analysis/src/BuiltinDefinitions.cpp",
        "luau/Analysis/src/BuiltinTypeFunctions.cpp",
        "luau/Analysis/src/Clone.cpp",
        "luau/Analysis/src/Constraint.cpp",
        "luau/Analysis/src/ConstraintGenerator.cpp",
        "luau/Analysis/src/ConstraintSolver.cpp",
        "luau/Analysis/src/DataFlowGraph.cpp",
        "luau/Analysis/src/DcrLogger.cpp",
        "luau/Analysis/src/Def.cpp",
        "luau/Analysis/src/EmbeddedBuiltinDefinitions.cpp",
        "luau/Analysis/src/EqSatSimplification.cpp",
        "luau/Analysis/src/Error.cpp",
        "luau/Analysis/src/ExpectedTypeVisitor.cpp",
        "luau/Analysis/src/FileResolver.cpp",
        "luau/Analysis/src/FragmentAutocomplete.cpp",
        "luau/Analysis/src/Frontend.cpp",
        "luau/Analysis/src/Generalization.cpp",
        "luau/Analysis/src/GlobalTypes.cpp",
        "luau/Analysis/src/InferPolarity.cpp",
        "luau/Analysis/src/Instantiation.cpp",
        "luau/Analysis/src/Instantiation2.cpp",
        "luau/Analysis/src/IostreamHelpers.cpp",
        "luau/Analysis/src/JsonEmitter.cpp",
        "luau/Analysis/src/LValue.cpp",
        "luau/Analysis/src/Linter.cpp",
        "luau/Analysis/src/Module.cpp",
        "luau/Analysis/src/NonStrictTypeChecker.cpp",
        "luau/Analysis/src/Normalize.cpp",
        "luau/Analysis/src/OverloadResolution.cpp",
        "luau/Analysis/src/Quantify.cpp",
        "luau/Analysis/src/Refinement.cpp",
        "luau/Analysis/src/RequireTracer.cpp",
        "luau/Analysis/src/Scope.cpp",
        "luau/Analysis/src/Simplify.cpp",
        "luau/Analysis/src/Substitution.cpp",
        "luau/Analysis/src/Subtyping.cpp",
        "luau/Analysis/src/Symbol.cpp",
        "luau/Analysis/src/TableLiteralInference.cpp",
        "luau/Analysis/src/ToDot.cpp",
        "luau/Analysis/src/ToString.cpp",
        "luau/Analysis/src/TopoSortStatements.cpp",
        "luau/Analysis/src/Transpiler.cpp",
        "luau/Analysis/src/TxnLog.cpp",
        "luau/Analysis/src/Type.cpp",
        "luau/Analysis/src/TypeArena.cpp",
        "luau/Analysis/src/TypeAttach.cpp",
        "luau/Analysis/src/TypeChecker2.cpp",
        "luau/Analysis/src/TypeFunction.cpp",
        "luau/Analysis/src/TypeFunctionReductionGuesser.cpp",
        "luau/Analysis/src/TypeFunctionRuntime.cpp",
        "luau/Analysis/src/TypeFunctionRuntimeBuilder.cpp",
        "luau/Analysis/src/TypeIds.cpp",
        "luau/Analysis/src/TypeInfer.cpp",
        "luau/Analysis/src/TypeOrPack.cpp",
        "luau/Analysis/src/TypePack.cpp",
        "luau/Analysis/src/TypePath.cpp",
        "luau/Analysis/src/TypeUtils.cpp",
        "luau/Analysis/src/TypedAllocator.cpp",
        "luau/Analysis/src/Unifiable.cpp",
        "luau/Analysis/src/Unifier.cpp",
        "luau/Analysis/src/Unifier2.cpp",
        "luau/Analysis/src/UserDefinedTypeFunction.cpp",
    },
    includes = {
        "luau/Ast/include",
        "luau/Common/include",
        "luau/Compiler/include",
        "luau/VM/include",
        "luau/Analysis/include",
        "luau/Config/include",
        "luau/EqSat/include",
    },
    public_includes = {
        "luau/Analysis/include",
        "luau/Ast/include",
        "luau/Config/include",
        "luau/EqSat/include",
        "luau/Common/include",
    },
    cpp_std = "c++17",
}
c_library "luau_vm" {
    sources = {
        "luau/VM/src/lapi.cpp",
        "luau/VM/src/laux.cpp",
        "luau/VM/src/lbaselib.cpp",
        "luau/VM/src/lbitlib.cpp",
        "luau/VM/src/lbuffer.cpp",
        "luau/VM/src/lbuflib.cpp",
        "luau/VM/src/lbuiltins.cpp",
        "luau/VM/src/lcorolib.cpp",
        "luau/VM/src/ldblib.cpp",
        "luau/VM/src/ldebug.cpp",
        "luau/VM/src/ldo.cpp",
        "luau/VM/src/lfunc.cpp",
        "luau/VM/src/lgc.cpp",
        "luau/VM/src/lgcdebug.cpp",
        "luau/VM/src/linit.cpp",
        "luau/VM/src/lmathlib.cpp",
        "luau/VM/src/lmem.cpp",
        "luau/VM/src/lnumprint.cpp",
        "luau/VM/src/lobject.cpp",
        "luau/VM/src/loslib.cpp",
        "luau/VM/src/lperf.cpp",
        "luau/VM/src/lstate.cpp",
        "luau/VM/src/lstring.cpp",
        "luau/VM/src/lstrlib.cpp",
        "luau/VM/src/ltable.cpp",
        "luau/VM/src/ltablib.cpp",
        "luau/VM/src/ltm.cpp",
        "luau/VM/src/ludata.cpp",
        "luau/VM/src/lutf8lib.cpp",
        "luau/VM/src/lveclib.cpp",
        "luau/VM/src/lvmexecute.cpp",
        "luau/VM/src/lvmload.cpp",
        "luau/VM/src/lvmutils.cpp",
    },
    includes = {
        "luau/Ast/include",
        "luau/Common/include",
        "luau/Compiler/include",
        "luau/VM/include",
        "luau/Analysis/include",
        "luau/Config/include",
        "luau/EqSat/include",
    },
    public_includes = {
        "luau/VM/include",
        "luau/Compiler/include",
        "luau/Ast/include",
        "luau/Common/include",
    },
    cpp_std = "c++17",
}
