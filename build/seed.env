# The Kiln release that builds Kiln from source: bootstrap.sh, CI, and any
# project that builds Kiln from its own checkout fetch it through seed.sh.
# Kiln's own manifests must stay readable by this release, so a change that
# makes them use something newer moves the seed to a release that has it.
KILN_SEED_VERSION=0.2.0
KILN_SEED_SHA256_LINUX_X86_64=32586c785b3a3bd4ed249d2060196a479382f8d29cb391d441945760edfc11ad
